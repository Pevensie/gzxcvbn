//// Common passwords dictionary and keyboard adjacency graphs.
////
//// This module provides:
//// - Common passwords (49233 entries)
//// - Keyboard adjacency graphs (6 layouts)

import gleam/dict
import gleam/option
import gzxcvbn

/// Get all common dictionaries.
pub fn dictionaries() -> List(gzxcvbn.NamedDictionary) {
  [passwords()]
}

/// Common passwords dictionary (49233 entries).
pub fn passwords() -> gzxcvbn.NamedDictionary {
  gzxcvbn.NamedDictionary(
    name: "passwords",
    kind: gzxcvbn.Passwords,
    dictionary: passwords_data(),
  )
}

/// Get all keyboard adjacency graphs.
pub fn graphs() -> List(gzxcvbn.NamedGraph) {
  [azerty(), dvorak(), keypad(), keypad_mac(), qwerty(), qwertz()]
}

/// azerty keyboard adjacency graph.
pub fn azerty() -> gzxcvbn.NamedGraph {
  gzxcvbn.NamedGraph(name: "azerty", graph: azerty_data())
}

/// dvorak keyboard adjacency graph.
pub fn dvorak() -> gzxcvbn.NamedGraph {
  gzxcvbn.NamedGraph(name: "dvorak", graph: dvorak_data())
}

/// keypad keyboard adjacency graph.
pub fn keypad() -> gzxcvbn.NamedGraph {
  gzxcvbn.NamedGraph(name: "keypad", graph: keypad_data())
}

/// keypad_mac keyboard adjacency graph.
pub fn keypad_mac() -> gzxcvbn.NamedGraph {
  gzxcvbn.NamedGraph(name: "keypad_mac", graph: keypad_mac_data())
}

/// qwerty keyboard adjacency graph.
pub fn qwerty() -> gzxcvbn.NamedGraph {
  gzxcvbn.NamedGraph(name: "qwerty", graph: qwerty_data())
}

/// qwertz keyboard adjacency graph.
pub fn qwertz() -> gzxcvbn.NamedGraph {
  gzxcvbn.NamedGraph(name: "qwertz", graph: qwertz_data())
}

